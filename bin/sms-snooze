#!/bin/bash
# sms-snooze: manage SMS reply popup snooze state.
# Usage: sms-snooze 15m|1h|off|clear|status
# State: ~/.cache/sms-snooze-until -> epoch seconds, "mute", or missing (active)
set -uo pipefail
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/sms-snooze-until"

cmd="${1:-status}"
case "$cmd" in
  15m|15min|15)
    date -d "+15 minutes" +%s > "$STATE"
    echo "SMS popups snoozed for 15 minutes."
    ;;
  1h|60m|hour|60)
    date -d "+60 minutes" +%s > "$STATE"
    echo "SMS popups snoozed for 1 hour."
    ;;
  off|mute|none|no)
    echo "mute" > "$STATE"
    echo "SMS popups muted (no notifications until cleared)."
    ;;
  clear|on|unmute|reset)
    rm -f "$STATE"
    echo "SMS popups re-enabled."
    ;;
  status)
    if [[ ! -f "$STATE" ]]; then
      echo "active (no snooze)"
      exit 0
    fi
    val=$(cat "$STATE")
    if [[ "$val" == "mute" ]]; then
      echo "muted (run 'sms-snooze clear' to re-enable)"
    else
      now=$(date +%s)
      if [[ "$val" =~ ^[0-9]+$ ]] && (( val > now )); then
        echo "snoozed for $(( (val - now) / 60 )) more minutes (until $(date -d "@$val" '+%H:%M'))"
      else
        rm -f "$STATE"
        echo "active (expired snooze cleared)"
      fi
    fi
    ;;
  *)
    echo "Usage: sms-snooze 15m|1h|off|clear|status" >&2
    exit 1
    ;;
esac
